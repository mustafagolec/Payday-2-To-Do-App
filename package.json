{
  "name": "crimenet-todo",
  "productName": "CRIME.NET",
  "version": "1.0.0",
  "description": "Payday 2 Crime.net temali gorev yoneticisi",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/make-icon.cjs",
    "prestart": "node scripts/make-icon.cjs",
    "dev": "concurrently -k -n VITE,ELECTRON -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 node scripts/run-electron.cjs\"",
    "dev:web": "vite",
    "build": "vite build",
    "icon": "node scripts/make-icon.cjs",
    "start": "npm run build && node scripts/run-electron.cjs",
    "dist": "node scripts/make-icon.cjs && vite build && electron-builder --win"
  },
  "dependencies": {
    "@fontsource/oswald": "^5.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.crimenet.todo",
    "productName": "CRIME.NET",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "CRIME.NET-${version}-portable.exe"
    },
    "compression": "maximum"
  }
}
